  },
  "dependencies": {},
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@yandex/ymaps3-types": "^1.0.20315584",
    "exifr": "^7.1.3",
    "sharp": "^0.35.3",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
