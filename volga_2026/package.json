{
  "name": "children-on-volga",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "import": "node --import tsx scripts/import-telegram.ts",
    "contact-sheet": "node --import tsx scripts/make-contact-sheets.ts",
    "validate-content": "node --import tsx scripts/validate-content.ts",
    "typecheck": "tsc --noEmit",
